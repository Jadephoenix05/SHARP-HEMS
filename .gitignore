# Large source and derived data never enter Git. Kaggle holds the data release.
data/
release/
.venv/
__pycache__/
*.pyc
*.7z
*.zip
sharp_integration_inputs.zip
sharp_build_context.zip
reports/_*.log
reports/emarc_daily_reconciliation_v1.csv
data_registry/sources_backup_*.yaml
raw_archive/

# Trained weights are regenerated by the notebook on Kaggle, not versioned here.
# The JSON training reports beside them ARE committed: they are the evidence.
models/**/*.npz
reports/kaggle_notebook_verification/
reports/notebook_verification.log

# Run logs are reproducible output, not evidence. The JSON reports are.
reports/*.log
handover/**/*.npz
